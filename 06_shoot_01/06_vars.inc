; 06_vars.inc - 06_shoot_01 固有のゼロページ変数

; 1P コントローラーの状態
pad1_raw   = $10    ; ベタ入力（押している間ずっと 1）
pad1_prev  = $11    ; 前フレームの pad1_raw
pad1_shot  = $12    ; ワンショット（押した瞬間だけ 1）

; 自機の中心座標（8.8 固定小数）
; sp0_*_hi は「機体中心」の整数座標。描画時に sync_oam が左上 (center-8) に変換する。
sp0_x_lo   = $20    ; X 小数部
sp0_x_hi   = $21    ; X 整数部（機体中心）
sp0_y_lo   = $22
sp0_y_hi   = $23

; 速度（8.8 固定小数・非負）
speed_lo   = $24
speed_hi   = $25
